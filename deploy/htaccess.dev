# ── dev.alvianpermana.art · internal surface ─────────────────
# The single most valuable control on this stack. Everything in the dev bundle
# is downloadable by anyone who can reach the host, so no in-app login can
# protect it. The wall below means an unauthenticated visitor never receives
# the JavaScript at all, which is a different class of protection from hiding
# a route inside the bundle.
#
# The wall is written in by .github/workflows/deploy.yml, which picks one of
# three modes and substitutes it for the @@DEV_WALL@@ marker below:
#
#   DEV_HTPASSWD_PATH set   HTTP basic auth against that htpasswd file. Best.
#                           Create it once over SSH, outside the web root:
#                             htpasswd -c /home/USER/.htpasswd-derzen derzen
#                           Hostinger hPanel can also generate one under
#                           "Password Protect Directories" and will report
#                           the absolute path to put in the secret.
#   DEV_ACCESS_TOKEN set    A shared phrase carried in the derzen_dev cookie.
#                           No SSH needed. Weaker than basic auth but still
#                           server enforced: no cookie, no bundle. Use only
#                           letters and digits, it lands in a regex.
#   neither set             Sealed. Every request is answered with gate.html,
#                           so no internal asset is served to anyone at all.
#
# Never let this surface ship without one of those three in place.

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# @@DEV_WALL@@

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://*.functions.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Belt and braces alongside robots.txt: an internal console has no business
  # in a search index or an archive.
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<FilesMatch "\.(map|env|log|sql|yml|yaml|json5|bak|old)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
